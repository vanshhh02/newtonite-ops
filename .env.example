# Newtonite Ops Environment Configuration

# Database URLs
# For docker-compose, use host "db". For local development, use "localhost".
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/newtonite
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/newtonite_test

# Authentication
SECRET_KEY=dev-secret-key-change-in-production-use-hs256
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Ops SLAs & Defaults
STALE_AFTER_HOURS=72

# Worker Configuration
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_BATCH_SIZE=20
